# Nebula Sentinel — Environment Configuration
# Copy to .env.local and fill in values

# MiMo Open Platform (required for v0.9+ API features)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com

# Deployment target
SOC_CLUSTER_ID=prod-soc-01
NODE_ENV=development

# Real-time telemetry (v0.9+)
TELEMETRY_WS_URL=

# Optional: incident store (v0.9+)
# DATABASE_URL=postgresql://user:pass@localhost:5432/nebula_sentinel
